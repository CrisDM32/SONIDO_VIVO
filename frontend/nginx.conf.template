server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location ~ ^/(api/|swagger-ui/|swagger-ui\.html$|v3/api-docs(?:/|$)) {
        proxy_pass http://${BACKEND_PRIVATE_IP}:8080;
        proxy_set_header Host $http_host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
